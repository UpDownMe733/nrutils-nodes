    {
        "id": "wfdemo.waitio",
        "type": "worker-function",
        "z": "wfdemo.tab",
        "name": "waits for I/O",
        "func": "// A handler that waits does not load the thread, so the load stays 0 %.\n// The badge on the node counts the calls that have started and not ended.\nworker.parentPorts.subscribe('input', async (msg) => {\n    await new Promise((resolve) => setTimeout(resolve, 4000));    // stands for a slow network call\n    msg.payload = 'waited 4 s';\n    worker.parentPorts.publish('send', msg);\n});\n",
        "outputs": 1,
        "noerr": 0,
        "libs": [],
