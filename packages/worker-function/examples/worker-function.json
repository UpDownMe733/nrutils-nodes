    {
        "id": "wfdemo.c2",
        "type": "comment",
        "z": "wfdemo.tab",
        "name": "2. Thread to thread: stage A to stage B",
        "info": "Stage A gets the flow message and publishes it on worker.outputPorts.\nStage B gets it on worker.inputPorts, adds a field and publishes send. The message goes from thread to thread, not through Node-RED.",
        "x": 200,
        "y": 240,
        "wires": []
    },
    {
        "id": "wfdemo.i3",
        "type": "inject",
        "z": "wfdemo.tab",
        "name": "timestamp",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 300,
        "wires": [
