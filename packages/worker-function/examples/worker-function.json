                "wfdemo.stageA"
            ]
        ]
    },
    {
        "id": "wfdemo.stageA",
        "type": "worker-function",
        "z": "wfdemo.tab",
        "name": "stage A",
        "func": "// Takes each flow message and sends it to the wired worker nodes, thread to thread.\n// The message does not go through Node-RED, so this node has no output to the flow.\nconst { threadId } = require('worker_threads');\n\nworker.parentPorts.subscribe('input', (msg) => {\n    msg.stageA = { thread: threadId };\n    worker.outputPorts.publish('input', msg);\n});\n",
        "outputs": 1,
        "libs": [],
        "x": 340,
        "y": 300,
        "wires": [
            [
                "wfdemo.stageB"
            ]
        ],
        "noerr": 0,
        "transfer": false
    },
    {
        "id": "wfdemo.stageB",
        "type": "worker-function",
        "z": "wfdemo.tab",
        "name": "stage B",
        "func": "// Gets each message from stage A, thread to thread, adds a field and sends it to the flow.\nconst { threadId } = require('worker_threads');\n\nworker.inputPorts.subscribe('input', (msg, senderTrace) => {\n    msg.stageB = { from: senderTrace.nodeId, thread: threadId };\n    worker.parentPorts.publish('send', msg);\n});\n",
        "outputs": 1,
        "libs": [],
        "x": 500,
        "y": 300,
        "wires": [
            [
                "wfdemo.d3"
            ]
        ],
        "noerr": 0,
        "transfer": false
