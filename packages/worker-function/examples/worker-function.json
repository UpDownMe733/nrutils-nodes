    {
        "id": "wfdemo.busy",
        "type": "worker-function",
        "z": "wfdemo.tab",
        "name": "busy loop",
        "func": "// This node publishes no status, so the node shows busy NN %, then idle.\nworker.parentPorts.subscribe('input', async (msg) => {\n    const end = Date.now() + 5000;\n    while (Date.now() < end);    // a long loop: the worker is busy, Node-RED is not\n    msg.payload = 'busy loop done';\n    worker.parentPorts.publish('send', msg);\n});\n",
        "outputs": 1,
        "noerr": 0,
