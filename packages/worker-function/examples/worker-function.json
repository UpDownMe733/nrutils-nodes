        "z": "wfdemo.tab",
        "name": "throws in handler",
        "func": "// A throw in a handler goes to node.error. A Catch node gets the error with the position\n// and the input message. The worker keeps running.\nworker.parentPorts.subscribe('input', (msg) => {\n    throw new Error('handler failed for payload ' + msg.payload);\n});\n",
