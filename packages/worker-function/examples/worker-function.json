    {
        "id": "wfdemo.c1",
        "type": "comment",
        "z": "wfdemo.tab",
        "name": "1. Heavy CPU work in a worker thread",
        "info": "Click the inject node. The worker function node counts the primes below 10 000 000 in its own thread.\nThe status shows the progress. The heartbeat in the Debug sidebar does not stop, because the event loop of Node-RED is free.",
        "x": 200,
        "y": 40,
        "wires": []
    },
    {
        "id": "wfdemo.i1",
        "type": "inject",
        "z": "wfdemo.tab",
        "name": "10 000 000",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "10000000",
        "payloadType": "num",
        "x": 150,
        "y": 100,
        "wires": [
            [
                "wfdemo.primes"
            ]
        ]
    },
    {
        "id": "wfdemo.primes",
        "type": "worker-function",
        "z": "wfdemo.tab",
        "name": "count primes",
        "func": "// Counts the primes below msg.payload. The loop runs in the worker thread,\n// so the heartbeat in the Debug sidebar does not stop.\nworker.parentPorts.subscribe('input', (msg) => {\n    const limit = Number(msg.payload) || 0;\n    const started = Date.now();\n    let count = 0;\n    for (let n = 2; n < limit; n++) {\n        let prime = true;\n        for (let d = 2; d * d <= n; d++) {\n            if (n % d === 0) { prime = false; break; }\n        }\n        if (prime) count++;\n        if (n % 500000 === 0) {\n            worker.parentPorts.publish('status', { fill: 'yellow', shape: 'ring', text: Math.round(100 * n / limit) + ' %' });\n        }\n    }\n    worker.parentPorts.publish('status', { fill: 'green', shape: 'dot', text: count + ' primes' });\n    msg.payload = { limit, count, ms: Date.now() - started };\n    worker.parentPorts.publish('send', msg);\n});\n",
        "outputs": 1,
        "libs": [],
        "x": 360,
        "y": 100,
        "wires": [
            [
                "wfdemo.d1"
            ]
        ],
        "noerr": 0,
        "transfer": false
    },
    {
        "id": "wfdemo.d1",
        "type": "debug",
        "z": "wfdemo.tab",
        "name": "primes result",
        "active": true,
        "tosidebar": true,
        "console": true,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 580,
        "y": 100,
        "wires": []
    },
